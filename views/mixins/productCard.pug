mixin productCard(product)
  .col-sm-6.col-lg-3

    a.product-card-link(href='/products/' + product.id)

      .product-tile.h-100

        .shoe-art

          span.tag.badge.text-bg-light
            = categoryLabel(product.category_id)

          span.shoe 👟

        .p-3

          .tiny= product.brand

          h5.fw-bold.my-1
            = product.name

          p.tiny.mt-2
            = product.description

          .d-flex.justify-content-between.align-items-center

            strong.fs-5
              = formatMoney(product.price)

            span.text-decoration-underline.tiny
              = __('ssr.common.viewDetail')
              i.bi.bi-arrow-up-right.ms-1