
extends ../layouts/store

block content

  .container.py-5

    .row.justify-content-center

      .col-lg-8

        .card.p-4.p-md-5.text-center.mb-4

          i.bi.bi-check-circle-fill.text-success(
            style='font-size: 4rem'
          )

          h1.fw-bold.mt-4
            = __('ssr.checkout.confirmationTitle')

          p.text-secondary
            = __('ssr.checkout.confirmationDescription')

          .border.rounded.p-3.mt-3

            small.text-secondary.d-block
              = __('ssr.checkout.orderNumber')

            code.fs-5= String(order._id)

          .row.g-3.mt-3

            .col-md-6

              small.text-secondary
                = __('ssr.cart.total')

              h4.fw-bold.mt-1

                = formatMoney(String(order.totals.total))

            .col-md-6

              small.text-secondary
                = __('ssr.checkout.paymentMethod')

              h5.mt-1

                = __('ssr.checkout.payment.' + order.paymentMethod)

        .card.p-4.mb-4

          h5.fw-bold.mb-4
            = __('ssr.checkout.summary')

          each item in order.items

            .d-flex.justify-content-between.border-bottom.py-3.gap-3

              div

                .fw-semibold

                  = item.name || ('#' + item.productId)

                if item.sku

                  small.text-secondary.d-block= item.sku

                small.text-secondary

                  = __('ssr.cart.quantity') + ': ' + item.quantity

              strong

                = formatMoney(Number(item.unitPrice.toString()) * item.quantity)

          hr

          .d-flex.justify-content-between.fs-5

            strong= __('ssr.cart.total')

            strong

              = formatMoney(String(order.totals.total))

        .card.p-4.mb-4

          h5.fw-bold.mb-3

            = __('ssr.checkout.shippingAddress')

          p.mb-1

            = order.shippingAddress.street + ' ' + order.shippingAddress.number

          p.mb-1

            = order.shippingAddress.city + ', ' + order.shippingAddress.state

          p.mb-0

            = order.shippingAddress.postalCode + ', ' + order.shippingAddress.country

        .d-grid.gap-2

          a.btn.btn-dark.btn-lg(
            href='/my/orders/' + String(order._id)
          )

            i.bi.bi-receipt.me-2

            = __('ssr.myOrders.viewDetail')

          a.btn.btn-outline-dark(href='/my/orders')

            = __('ssr.myOrders.title')

          a.btn.btn-outline-secondary(href='/products')

            = __('ssr.cart.continueShopping')