extends ../layouts/store
include ../mixins/productCard

block content

  section.hero

    .container

      .col-lg-7

        span.badge.text-bg-light.mb-3
          = __('ssr.home.collection')

        h1
          = __('ssr.home.heroTitle')
          br

          span.hero-highlight
            = __('ssr.home.heroHighlight')

        p.fs-5.opacity-75
          = __('ssr.home.description')

        a.btn.btn-lime.btn-lg(href="/products")
          = __('ssr.home.explore')
          i.bi.bi-arrow-right.ms-2

  section.container.py-5

    .d-flex.justify-content-between.align-items-end.flex-wrap.gap-2.mb-4

      div

        span.text-uppercase.tiny.fw-bold
          = __('ssr.home.selected')

        h2.fw-bold.mb-0
          = __('ssr.home.featured')

      a.btn.btn-outline-dark(href="/products")
        = __('ssr.home.viewCatalog')

    .row.g-4

      each product in products

        +productCard(product)

      else

        .col-12

          .store-panel.text-center.py-5

            i.bi.bi-box-seam.display-4.text-secondary

            p.text-secondary.mt-3
              = __('ssr.catalog.empty')