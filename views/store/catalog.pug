extends ../layouts/store
include ../mixins/productCard

block content

  .container.py-5

    .mb-4

      span.tiny.text-uppercase.fw-bold
        | Stride-Co /
        = ' ' + __('ssr.nav.store')

      h2.fw-bold.mb-0
        = __('ssr.catalog.title')

    form.store-panel.mb-4(method="GET" action="/products")

      input(type="hidden" name="lang" value=locale)

      .row.g-3.align-items-end

        .col-md-5

          label.form-label(for="q")
            = __('ssr.catalog.search')

          input#q.form-control(
            type="search"
            name="q"
            value=q
            maxlength="150"
            placeholder=__('ssr.catalog.searchPlaceholder')
          )

        .col-md-4

          label.form-label(for="category")
            = __('ssr.catalog.category')

          select#category.form-select(name="category")

            option(value="")
              = __('ssr.catalog.allCategories')

            each item in categories

              option(
                value=item.id
                selected=(category === String(item.id))
              )
                = item.name

        .col-md-3

          button.btn.btn-dark.w-100(type="submit")
            i.bi.bi-search.me-2
            = __('ssr.common.search')

    .d-flex.justify-content-between.align-items-center.mb-3

      p.text-secondary.mb-0
        = __('ssr.catalog.results') + ': ' + total

      if q || category

        a.btn.btn-outline-secondary.btn-sm(href="/products?lang=" + locale)
          = __('ssr.catalog.clearFilters')

    .row.g-4

      each product in products

        +productCard(product)

      else

        .col-12

          .store-panel.text-center.py-5

            i.bi.bi-search.display-4.text-secondary

            p.text-secondary.mt-3
              = __('ssr.catalog.empty')

            a.btn.btn-dark(href="/products?lang=" + locale)
              = __('ssr.catalog.clearFilters')

    include ../partials/pagination